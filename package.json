{
  "name": "ag-tablette",
  "version": "1.5.2 beta",
  "type": "module",
  "scripts": {
    "dev": "astro dev --port 4324",
    "dev:e2e": "astro dev --host 127.0.0.1 --port 4324 --strictPort",
    "disable-dev-toolbar": "astro preferences disable devToolbar",
    "build": "astro build",
    "store:release:prepare": "node ./scripts/store/prepare-release.js",
    "store:release:wrappers": "node ./scripts/store/run-release-stage.js --stage prepare",
    "store:release:publish": "node ./scripts/store/run-release-stage.js --stage publish",
    "store:release": "pnpm run test && pnpm run build && pnpm run store:release:prepare",
    "deploy": "firebase deploy",
    "deploy:beta": "firebase deploy --only hosting:beta",
    "deploy:beta2": "firebase hosting:channel:deploy beta --expires 30d",
    "deploy:rules": "pnpm run deploy:firestore-rules && pnpm run deploy:storage-rules",
    "deploy:firestore-rules": "firebase deploy --only firestore:rules",
    "deploy:storage-rules": "firebase deploy --only storage",
    "lint": "eslint . --ext .js,.ts",
    "lint:fix": "eslint . --ext .js,.ts --fix",
    "format": "prettier --write \"src/**/*.{js,ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{js,ts,json}\"",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:playwright": "playwright test",
    "test:playwright:ci": "playwright test --project=chromium",
    "test:coverage": "vitest run --coverage",
    "test:all": "pnpm run test && pnpm run test:playwright"
  },
  "devDependencies": {
    "@open-wc/testing": "^4.0.0",
    "@playwright/test": "^1.52.0",
    "@types/node": "^25.0.8",
    "@typescript-eslint/eslint-plugin": "^8.56.0",
    "@typescript-eslint/parser": "^8.56.0",
    "@vite-pwa/astro": "^1.2.0",
    "@vitest/coverage-v8": "^4.0.9",
    "eslint": "^10.0.1",
    "eslint-plugin-lit": "^2.1.1",
    "fake-indexeddb": "^6.2.5",
    "jsdom": "^29.0.1",
    "prettier": "^3.6.2",
    "typescript": "^6.0.3",
    "vitest": "^4.0.9"
  },
  "dependencies": {
    "@astrojs/lit": "^4.3.0",
    "@lit-labs/signals": "^0.3.0",
    "@webcomponents/template-shadowroot": "^0.2.1",
    "astro": "^6.1.2",
    "fflate": "^0.8.0",
    "firebase": "^12.2.1",
    "lz-string": "^1.5.0"
  }
}
