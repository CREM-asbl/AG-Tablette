name: PWA Android Store

on:
  workflow_dispatch:
    inputs:
      track:
        description: Google Play track
        required: true
        default: internal
        type: choice
        options:
          - internal
          - alpha
          - beta
          - production

permissions:
  contents: read

env:
  JAVA_VERSION: '17'
  NODE_VERSION: '22'
  TWA_DIR: android/twa

jobs:
  publish-android:
    runs-on: ubuntu-latest

    steps:
      - uses: actions/checkout@v4

      - uses: actions/setup-node@v4
        with:
          node-version: ${{ env.NODE_VERSION }}
          cache: npm

      - uses: actions/setup-java@v4
        with:
          distribution: temurin
          java-version: ${{ env.JAVA_VERSION }}

      - name: Install Bubblewrap
        run: npm install -g @bubblewrap/cli

      - name: Configure Bubblewrap for CI
        shell: bash
        run: |
          mkdir -p "${HOME}/.bubblewrap"
          test -n "${JAVA_HOME:-}" || { echo "JAVA_HOME is not set"; exit 1; }
          python3 -c 'import json, os; print(json.dumps({"jdkPath": os.environ.get("JAVA_HOME", ""), "androidSdkPath": os.environ.get("ANDROID_HOME", "/usr/local/lib/android/sdk")}))' > "${HOME}/.bubblewrap/config.json"

      - name: Restore keystore
        shell: bash
        run: |
          echo "${{ secrets.BUBBLEWRAP_KEYSTORE_BASE64 }}" | base64 --decode > "${TWA_DIR}/play-upload-key.jks"

      - name: Update TWA project from twa-manifest.json
        working-directory: ${{ env.TWA_DIR }}
        env:
          BUBBLEWRAP_KEYSTORE_PASSWORD: ${{ secrets.BUBBLEWRAP_KEYSTORE_PASSWORD }}
          BUBBLEWRAP_KEY_PASSWORD: ${{ secrets.BUBBLEWRAP_KEY_PASSWORD }}
        run: |
          bubblewrap update --manifest=./twa-manifest.json

      - name: Build signed App Bundle
        working-directory: ${{ env.TWA_DIR }}
        env:
          BUBBLEWRAP_KEYSTORE_PASSWORD: ${{ secrets.BUBBLEWRAP_KEYSTORE_PASSWORD }}
          BUBBLEWRAP_KEY_PASSWORD: ${{ secrets.BUBBLEWRAP_KEY_PASSWORD }}
        run: |
          bubblewrap build --manifest=./twa-manifest.json --signingKeyPath=./play-upload-key.jks --signingKeyAlias="${{ secrets.BUBBLEWRAP_KEYSTORE_ALIAS }}"

      - name: Publish bundle to Google Play
        working-directory: ${{ env.TWA_DIR }}
        run: |
          printf '%s' '${{ secrets.PLAY_SERVICE_ACCOUNT_JSON }}' > ./play-service-account.json
          bubblewrap play publish --manifest=./twa-manifest.json --serviceAccountFile=./play-service-account.json --track="${{ inputs.track }}" --appBundleLocation=./app-release-bundle.aab

      - name: Upload bundle artifact
        uses: actions/upload-artifact@v4
        with:
          name: android-app-bundle
          path: ${{ env.TWA_DIR }}/app-release-bundle.aab
          if-no-files-found: error

# Required secrets:
# - BUBBLEWRAP_KEYSTORE_BASE64
# - BUBBLEWRAP_KEYSTORE_ALIAS
# - BUBBLEWRAP_KEYSTORE_PASSWORD
# - BUBBLEWRAP_KEY_PASSWORD
# - PLAY_SERVICE_ACCOUNT_JSON
#
# Expected committed files:
# - android/twa/twa-manifest.json
# - android/twa/ (versioned Bubblewrap project)
