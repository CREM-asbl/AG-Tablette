---
import { KNOWN_OPEN_SLUGS } from '@services/known-open-slugs';

export function getStaticPaths() {
  return KNOWN_OPEN_SLUGS.map((slug) => ({ params: { slug } }));
}

const slug = Astro.params.slug;
const target = slug
  ? `/?slug=${encodeURIComponent(slug)}`
  : '/';
---

<!doctype html>
<html lang="fr">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>AG mobile - ouverture</title>
    <meta http-equiv="refresh" content={`0; url=${target}`} />
    <script is:inline define:vars={{ target }}>
      (function () {
        var t = target || '/';
        var qs = window.location.search ? window.location.search.replace(/^\?/, '') : '';
        if (qs) t += (t.indexOf('?') >= 0 ? '&' : '?') + qs;
        window.location.replace(t);
      })();
    </script>
  </head>
  <body></body>
</html>